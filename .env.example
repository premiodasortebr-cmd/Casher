# Local: rode `npm run dev` e preencha tudo pela tela /setup (grava .env.local).
# Produção (Render): configure essas variáveis no painel — /setup gera o ADMIN_PIN_HASH.

# Supabase → Project Settings → API. Só usadas no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Database → Connection string → Session pooler (URI, com a senha).
# Usada só pra aplicar as migrations (npm run dev / npm start / npm run migrate).
DATABASE_URL=

# Assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Hash do PIN de 6 dígitos do /admin (nunca o PIN puro). Gere com:
#   node scripts/gerar-hash.mjs 123456
ADMIN_PIN_HASH=
